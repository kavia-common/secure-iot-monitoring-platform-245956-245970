# Request the actual backend URL from the user/orchestrator for the frontend container.
# Do not commit the real .env file.

# Canonical backend HTTP origin used by REST API requests.
REACT_APP_API_BASE_URL=http://localhost:3001

# Canonical Socket.IO origin used for realtime connections.
# Keep this aligned with the backend host unless you intentionally proxy sockets elsewhere.
REACT_APP_SOCKET_URL=http://localhost:3001
